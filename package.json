{
  "name": "planai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "git config core.hooksPath scripts/git-hooks || true",
    "mobile:start": "cd apps/mobile && npx expo start",
    "mobile:android": "cd apps/mobile && npx expo run:android",
    "mobile:build:apk": "cd apps/mobile && npx eas-cli build --platform android --profile preview",
    "mobile:typecheck": "cd apps/mobile && npx tsc --noEmit"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "multer": "2.3.0"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
