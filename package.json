{
  "name": "planai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "git config core.hooksPath scripts/git-hooks || true",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:migrate": "docker compose exec api npm run migrate --workspace=api",
    "docker:seed": "docker compose exec api npm run seed --workspace=api",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "dependencies": {
    "expo-dev-client": "~6.0.21",
    "expo": "~54.0.35",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "version": "1.0.0"
}
