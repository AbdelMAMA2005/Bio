# =============================================================================
# PlanAI — variables d'environnement (Supabase)
# =============================================================================
# Copiez ce fichier vers .env si vous souhaitez conserver un fichier de config
# partagé pour les scripts ou les outils hors Expo.
#
# Le frontend mobile lit les variables EXPO_PUBLIC_* via apps/mobile/.env.
# Les valeurs ci-dessous sont les clés de remplacement, utiles pour les services
# côté serveur ou les fonctions Edge.
# =============================================================================

# --- Supabase -------------------------------------------------------------
# Remplacez par votre projet Supabase réel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Google OAuth ---------------------------------------------------------
# Client ID Web de Google, identique à EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID dans
# apps/mobile/.env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Variables optionnelles backend/Edge ----------------------------------
# À compléter si vous ajoutez des fonctions Edge ou des services serveur qui
# doivent appeler Supabase en mode service role.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
