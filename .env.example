# =============================================================================
# PlanAI — variables d'environnement Docker Compose (racine du monorepo)
# =============================================================================
# Copier ce fichier en `.env` (`cp .env.example .env`) : les valeurs par défaut
# ci-dessous configurent uniquement Docker Compose. Les secrets de l'API sont
# dans `apps/api/.env` et les variables clientes Expo dans `apps/mobile/.env`.
#
# NB : copier aussi `apps/api/.env.example` vers `apps/api/.env` avant le
# premier démarrage. Les deux fichiers `.env` sont gitignorés.
# =============================================================================

# --- Base de données PostgreSQL --------------------------------------------
# Utilisées par le service PostgreSQL et injectées dans le conteneur API.
DB_HOST=localhost
# DB_PORT : port PostgreSQL exposé sur la machine hôte. Volontairement 5433
# (pas le 5432 par défaut) pour ne jamais entrer en conflit avec un PostgreSQL
# déjà installé manuellement sur la machine d'un des deux devs.
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=planai_db

# --- Serveur ------------------------------------------------------------
PORT=3000

# --- Docker Compose uniquement -------------------------------------------
# Port hôte pour Adminer (interface web d'inspection de la base).
ADMINER_PORT=8080
