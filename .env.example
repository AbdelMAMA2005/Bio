# =============================================================================
# PlanAI — variables d'environnement (racine du monorepo)
# =============================================================================
# Copier ce fichier en `.env` (`cp .env.example .env`) : les valeurs par défaut
# ci-dessous fonctionnent immédiatement avec `docker compose up`, sans aucun
# secret réel commité. Ce `.env` est lu par docker-compose.yml (service "api"
# et service "db"). Voir "Environnement de développement avec Docker" dans
# ARCHITECTURE.md (ou DOCKER.md) pour le détail.
#
# NB : apps/api/.env (existant, gitignoré) reste utilisé si vous lancez l'API
# directement sur l'hôte (`cd apps/api && npm run start:dev`, sans Docker) —
# les deux fichiers coexistent, ils ne se remplacent pas.
# =============================================================================

# --- Base de données PostgreSQL --------------------------------------------
# Lues telles quelles par apps/api/src/config/typeorm.config.ts (PAS de
# DATABASE_URL : ce nom de variable n'est lu nulle part dans le code, voir
# BACKEND_ISSUES.md §7).
#
# DB_HOST : "localhost" si apps/api tourne sur l'hôte (hors Docker). Ignoré
# pour le service "api" du docker-compose, qui force DB_HOST=db (nom du
# service Postgres sur le réseau interne Docker) — voir docker-compose.yml.
DB_HOST=localhost
# DB_PORT : port PostgreSQL exposé sur la machine hôte. Volontairement 5433
# (pas le 5432 par défaut) pour ne jamais entrer en conflit avec un PostgreSQL
# déjà installé manuellement sur la machine d'un des deux devs.
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=planai_db

# --- Authentification ---------------------------------------------------
# Secret de signature des JWT (arbitraire en dev, à générer aléatoirement en
# prod : `openssl rand -hex 32`).
JWT_SECRET=dev_jwt_secret_change_me

# Client ID OAuth Google de type "Application Web" (Google Cloud Console >
# APIs & Services > Credentials) — DOIT être identique à
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID côté apps/mobile/.env (l'audience du
# idToken Google est toujours celle du client Web). Laisser vide désactive
# juste POST /auth/google (le reste de l'API fonctionne sans).
GOOGLE_CLIENT_ID=

# --- Identification de plantes (Plant.id) -----------------------------------
PLANT_ID_API_KEY=
PLANT_ID_API_URL=https://api.plant.id/v3/identification
# true = ne jamais appeler Plant.id réellement (réponses mockées). Pratique
# tant que PLANT_ID_API_KEY est vide.
MOCK_PLANTID=true
FORCE_MOCK=false

# --- Serveur ------------------------------------------------------------
PORT=3000

# Origines autorisées par CORS, séparées par des virgules (ex:
# https://app.planai.app,https://planai.app). Laisser vide en dev : le back
# n'autorise alors que localhost/IP LAN (voir apps/api/src/main.ts). À
# renseigner obligatoirement en production — jamais de `*` ouvert à tout le web.
CORS_ORIGIN=

# --- Docker Compose uniquement -------------------------------------------
# Port hôte pour Adminer (interface web d'inspection de la base).
ADMINER_PORT=8080
