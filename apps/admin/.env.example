# URL de l'API PlanAI (apps/api). Laisser tel quel pour un dev local classique.
VITE_API_URL=http://localhost:3000

# Optionnel — n'active QUE le test d'intégration réel (npm test, voir
# src/integration.smoke.test.tsx) : identifiants d'un compte admin de test jetable
# (créé via POST /auth/register puis promu role='admin' en base). Laisser vide sinon —
# ce test s'ignore alors silencieusement. NE JAMAIS committer de vraies valeurs ici.
VITE_SMOKE_ADMIN_EMAIL=
VITE_SMOKE_ADMIN_PASSWORD=
