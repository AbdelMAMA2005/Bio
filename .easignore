# EAS Build tar l'intégralité du monorepo (racine du dépôt git) avant upload — ce fichier
# réduit le poids/temps de cet upload en excluant tout ce qui n'est pas nécessaire à la
# compilation native + au bundle JS de apps/mobile. N'affecte PAS le poids final de
# l'APK/AAB (voir section "Réduction du poids de l'app" de rapport.md pour ça) : uniquement
# le temps d'upload/le cache de build côté serveur EAS.

# Docs de cadrage / specs (PDF, maquette HTML) — déjà hors dépôt, filet de sécurité
Cahier de charge/
*.pdf

# Documentation (jamais nécessaire à l'exécution)
*.md
!apps/mobile/README.md

# apps/api : jamais utilisé pour builder apps/mobile (pas d'import cross-app côté JS natif).
# On garde package.json pour que la résolution des workspaces npm ne casse pas l'install,
# on exclut tout le reste (code, tests, uploads, build intermédiaire).
apps/api/src
apps/api/test
apps/api/uploads
apps/api/dist
apps/api/coverage
apps/api/Dockerfile
apps/api/.env*

# Fichiers de dev/CI non nécessaires au build natif
.github
.vscode
.claude
docker-compose.yml
.dockerignore
DOCKER.md
DOCKER_CONFIGURATION.md

# Tests, coverage, scripts hors mobile
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
coverage
apps/mobile/coverage

# Artefacts locaux
releases/
.git
.expo
apps/mobile/.expo
apps/mobile/.expo-production-check
node_modules
**/node_modules
# Gradle cache files may be locked by Android Studio or a local build. They
# are not source files and must not be included in an EAS upload.
android/.gradle/
android/build/
android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
